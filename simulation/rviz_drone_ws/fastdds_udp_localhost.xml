<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS profile for every ROS 2 process of this repository (simulator node, ros2 command-line
  tools, RViz, Isaac Sim ROS 2 bridge): UDPv4 on the loopback interface only, built-in transports
  (including shared memory in /dev/shm) disabled. Set through FASTRTPS_DEFAULT_PROFILES_FILE by
  ../rviz_drone/env.sh and ../isaac_render/isaac_python.sh.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_localhost</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_localhost_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_localhost</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
