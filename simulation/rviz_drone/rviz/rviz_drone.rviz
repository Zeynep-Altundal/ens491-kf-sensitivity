Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 5
      Plane Cell Count: 14
      Offset:
        X: 20
        Y: 10
        Z: 0
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.5
      Show Names: true
    - Class: rviz_default_plugins/Marker
      Name: Drone
      Enabled: true
      Topic:
        Value: /drone/marker
    - Class: rviz_default_plugins/Path
      Name: Truth path
      Enabled: true
      Color: 25; 255; 0
      Topic:
        Value: /drone/truth/path
    - Class: rviz_default_plugins/PointStamped
      Name: Position measurement
      Enabled: true
      Color: 204; 41; 204
      Radius: 0.08
      History Length: 20
      Topic:
        Value: /drone/position
    - Class: rviz_default_plugins/Path
      Name: Estimate KF path
      Enabled: true
      Color: 31; 119; 180
      Topic:
        Value: /drone/estimate/kf/path
    - Class: rviz_default_plugins/Path
      Name: Estimate EKF path
      Enabled: true
      Color: 255; 127; 14
      Topic:
        Value: /drone/estimate/ekf/path
    - Class: rviz_default_plugins/Path
      Name: Estimate ESKF path
      Enabled: true
      Color: 23; 190; 207
      Topic:
        Value: /drone/estimate/eskf/path
    - Class: rviz_default_plugins/Marker
      Name: Covariance KF (3 sigma)
      Enabled: true
      Topic:
        Value: /drone/estimate/kf/covariance
    - Class: rviz_default_plugins/Marker
      Name: Covariance EKF (3 sigma)
      Enabled: true
      Topic:
        Value: /drone/estimate/ekf/covariance
    - Class: rviz_default_plugins/Marker
      Name: Covariance ESKF (3 sigma)
      Enabled: true
      Topic:
        Value: /drone/estimate/eskf/covariance
    - Class: rviz_default_plugins/MarkerArray
      Name: Peaks
      Enabled: true
      Topic:
        Durability Policy: Transient Local
        Value: /drone/analysis/peaks
    - Class: rviz_default_plugins/Marker
      Name: Corruption banner
      Enabled: true
      Topic:
        Value: /drone/analysis/outage_marker
    - Class: rviz_default_plugins/Path
      Name: Estimate SPARE (reserved)
      Enabled: true
      Color: 255; 215; 0
      Topic:
        Value: /drone/estimate/spare/path
  Enabled: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 62
      Focal Point:
        X: 20
        Y: 10
        Z: 1.5
      Pitch: 0.75
      Yaw: -1.9
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1400
